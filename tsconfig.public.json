{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/control-center/public/**/*.js"]
}
