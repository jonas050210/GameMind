{
  "name": "gamemind",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, observable game-AI runtime with a Minecraft Java adapter.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "scenario:demo": "tsx src/cli.ts --demo",
    "scenario:minecraft": "tsx src/cli.ts --minecraft --look-yaw 1.5707963267948966 --look-pitch 0",
    "task:demo": "tsx src/cli.ts --demo-task",
    "task:demo:craft": "tsx src/cli.ts --demo-task craft-wooden-pickaxe",
    "task:demo:food": "tsx src/cli.ts --demo-task secure-food",
    "task:minecraft": "tsx src/cli.ts --task gather-logs --one-shot",
    "task:minecraft:craft": "tsx src/cli.ts --task craft-wooden-pickaxe --one-shot",
    "task:minecraft:food": "tsx src/cli.ts --task secure-food --one-shot",
    "sim:demo": "tsx src/cli.ts --sim food-remote-berries --seed 101",
    "sim:demo:explore": "tsx src/cli.ts --sim explore-remote-log --seed 101",
    "sim:demo:stall": "tsx src/cli.ts --sim recovery-single-hidden-obstacle --seed 101",
    "eval:offline": "tsx src/eval.ts",
    "eval:offline:quick": "tsx src/eval.ts --seeds 5",
    "ui:demo": "tsx src/cli.ts --sim explore-remote-log --seed 101 --control-center --control-host 0.0.0.0",
    "ui:demo:offline": "tsx src/cli.ts --demo-task --control-center --control-host 0.0.0.0",
    "task:demo:mine": "tsx src/cli.ts --sim mine-stone-with-pickaxe --seed 101",
    "task:minecraft:mine": "tsx src/cli.ts --task mine-stone --one-shot",
    "task:minecraft:shelter": "tsx src/cli.ts --task build-shelter --one-shot",
    "policy:status": "tsx src/cli.ts --policy status",
    "test:live": "tsx src/testing/live/live-test-runner.ts",
    "test:live:quick": "tsx src/testing/live/live-test-runner.ts --scenario live-connection",
    "profile:autonomy": "tsx src/testing/autonomy-profile.ts",
    "perf:observe": "tsx src/testing/perf/observe-benchmark.ts",
    "train": "tsx src/training/cli.ts",
    "train:experiment": "tsx src/training/experiment-cli.ts",
    "train:benchmark": "tsx src/training/benchmark-cli.ts",
    "test:record": "node scripts/record-test-run.mjs",
    "roadmap": "tsx src/roadmap/cli.ts",
    "app": "tsx src/cli.ts",
    "app:build": "node dist/src/cli.js",
    "train:status": "tsx src/training/cli.ts status",
    "test:launcher": "python3 -m unittest discover -s tests_py -t ."
  },
  "dependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-tool": "1.2.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prismarine-registry": "1.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
